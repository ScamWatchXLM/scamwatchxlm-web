# Data source mode: "mock" (default, no backend required) or "live"
NEXT_PUBLIC_API_MODE=mock

# Only required when NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=https://api.scamwatchxlm.org/v1
NEXT_PUBLIC_WS_BASE_URL=wss://api.scamwatchxlm.org/v1/stream

# Public site URL, used for metadata/OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
